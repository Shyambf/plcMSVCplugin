<UserControl x:Class="plcMSVCplugin.PlanInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="850"
             Background="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!-- Стиль кнопок в стиле тем оформления Visual Studio -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowButtonHoverActiveBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowButtonDownBrushKey}}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowButtonDownBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль флажка -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Стиль вкладок TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.CommandBarGradientBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3,3,0,0"
                                Margin="{TemplateBinding Margin}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                              ContentSource="Header"
                                              Focusable="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowButtonHoverActiveBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBackgroundBrushKey}}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1,2,1,0" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTabSelectedBorderBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTabSelectedTextBrushKey}}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для таблиц DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#08FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.GridLineBrushKey}}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.GridLineBrushKey}}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.GridHeadingBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.GridHeadingTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.GridLineBrushKey}}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.SystemHighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.SystemHighlightTextBrushKey}}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.CommandBarGradientBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.SystemHighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.SystemHighlightTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стили для списков ListBox (стек вызовов) -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.CommandBarGradientBrushKey}}" />
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.SystemHighlightBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.SystemHighlightTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль группировки GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="2,0,0,4">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border Grid.Row="1"
                                    Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для дерева плана TreeView -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#007ACC" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3F3F46" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
            </Style.Resources>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <!-- Стиль разделителей GridSplitter -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <!-- Стиль разделителей Separator -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="Height" Value="1" />
        </Style>

        <!-- Стиль текстовых полей TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.SystemHighlightBrushKey}}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель управления и статуса отладчика -->
        <Border Grid.Row="0" Margin="0,0,0,6" Padding="6" CornerRadius="3"
                Background="{DynamicResource {x:Static vsshell:EnvironmentColors.CommandBarGradientBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Статус отладчика -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="#808080" Margin="0,0,6,0" />
                    <TextBlock x:Name="StatusText" Text="Отладчик не запущен" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Кнопки действий -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnStartDebug" Content="Отладка" ToolTip="Запуск отладки Planning C (Shift+Alt+F5)" Margin="3,0" Padding="6,3" Click="BtnStartDebug_Click" />
                    <Button x:Name="BtnRunWithoutDebug" Content="Без отладки" ToolTip="Запуск Planning C без отладки в консоли (Ctrl+F5)" Margin="3,0" Padding="6,3" Click="BtnRunWithoutDebug_Click" />
                    <Button x:Name="BtnCleanBuild" Content="Очистить .plc_build" ToolTip="Очистить промежуточные файлы сборки Planning C" Margin="3,0" Padding="6,3" Click="BtnCleanBuild_Click" />
                    <Button x:Name="BtnRefresh" Content="Обновить" ToolTip="Обновить состояние из отладчика" Margin="3,0" Padding="6,3" Click="BtnRefresh_Click" />
                    <CheckBox x:Name="ChkAutoRefresh" Content="Авто-обновление" ToolTip="Автоматически обновлять при остановке на точке останова" IsChecked="True" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Вкладки инспектора -->
        <TabControl Grid.Row="1" Background="Transparent"
                    BorderBrush="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}">

            <!-- Вкладка 1: Потоки и стадии -->
            <TabItem Header="Потоки процесса (Threads)">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridThreads" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="GridThreads_SelectionChanged"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                            <DataGridTextColumn Header="Имя / Роль потока" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="150" />
                            <DataGridTextColumn Header="Текущая функция" Binding="{Binding Location}" Width="2*" />
                            <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Margin="0,2" />

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="Стек вызовов выбранного потока:" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListBox x:Name="ListCallStack" Background="Transparent" FontFamily="Consolas" FontSize="11" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Состояние плана -->
            <TabItem Header="Состояние плана (Plan State)">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Сводная карточка состояния плана -->
                    <Border Grid.Row="0" Margin="0,0,0,6" Padding="8" CornerRadius="4"
                            BorderBrush="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}"
                            BorderThickness="1"
                            Background="{DynamicResource {x:Static vsshell:EnvironmentColors.CommandBarGradientBrushKey}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="4">
                                <TextBlock Text="Статус выполнения плана:" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" Opacity="0.75" />
                                <TextBlock x:Name="TxtPlanStatus" Text="План не активен" FontSize="13" FontWeight="Bold" Margin="0,2,0,4" />
                                <TextBlock Text="Задач в очереди плана:" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" Opacity="0.75" />
                                <TextBlock x:Name="TxtPlanTasksCount" Text="0" FontSize="13" FontWeight="Bold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4">
                                <TextBlock Text="Текущая стадия конвейера:" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" Opacity="0.75" />
                                <TextBlock x:Name="TxtCurrentStage" Text="-" FontSize="13" FontWeight="Bold" Margin="0,2,0,4" />
                                <TextBlock Text="Всего стадий (Stages):" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" Opacity="0.75" />
                                <TextBlock x:Name="TxtTotalStages" Text="-" FontSize="13" FontWeight="Bold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="4">
                                <TextBlock Text="Контекст процессора (ID):" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" Opacity="0.75" />
                                <TextBlock x:Name="TxtProcessorContext" Text="-" FontSize="13" FontWeight="Bold" Margin="0,2,0,4" />
                                <TextBlock Text="Режим параллелизма:" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" Opacity="0.75" />
                                <TextBlock x:Name="TxtParallelMode" Text="-" FontSize="13" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Содержимое очереди плана и параметров задач -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.3*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <!-- Таблица элементов очереди плана (Cur, Ins, параметры задач) -->
                        <GroupBox Grid.Row="0" Header="Очередь задач текущего плана (Элементы и параметры plan_first / plan_last)">
                            <DataGrid x:Name="GridPlanTasks" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      SelectionMode="Single" SelectionChanged="GridPlanTasks_SelectionChanged"
                                      Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding Index}" Width="45" />
                                    <DataGridTextColumn Header="Процедура / Функция" Binding="{Binding TargetFunction}" Width="150" />
                                    <DataGridTextColumn Header="Параметры задачи" Binding="{Binding Parameters}" Width="2*" />
                                    <DataGridTextColumn Header="Значения данных (Data)" Binding="{Binding ValuesPreview}" Width="1.4*" />
                                    <DataGridTextColumn Header="Флаги / Статус" Binding="{Binding Flags}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Margin="0,2" />

                        <!-- Иерархическая структура и детальный просмотр выбранной задачи -->
                        <GroupBox Grid.Row="2" Header="Иерархическая структура плана и детальный просмотр">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TreeView x:Name="TreePlan" Grid.Column="0" Background="Transparent" Margin="2" />
                                <Border Grid.Column="1" BorderBrush="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                        BorderThickness="1,0,0,0" Margin="4,0,0,0" Padding="6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Детали выбранной задачи плана:" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtTaskDetail" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                                 Background="Transparent" TextWrapping="Wrap" BorderThickness="0"
                                                 Text="Выберите задачу в таблице выше для детального просмотра параметров." />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Отображение каналов данных и переменных -->
            <TabItem Header="Отображение содержимого (Channels &amp; Data)">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <!-- Таблица каналов данных с содержимым буфера -->
                    <GroupBox Grid.Row="0" Header="Каналы данных (funnel, cfunnel, cvar) и их содержимое">
                        <DataGrid x:Name="GridFunnels" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single" SelectionChanged="GridFunnels_SelectionChanged"
                                  Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя канала" Binding="{Binding Name}" Width="130" />
                                <DataGridTextColumn Header="Тип / Направление" Binding="{Binding Direction}" Width="140" />
                                <DataGridTextColumn Header="Емкость (N)" Binding="{Binding Capacity}" Width="90" />
                                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120" />
                                <DataGridTextColumn Header="Содержимое буфера / Значение" Binding="{Binding ContentPreview}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Margin="0,2" />

                    <!-- Детальный просмотр выбранного буфера -->
                    <GroupBox Grid.Row="2" Header="Детальное содержимое выбранного канала / очереди">
                        <TextBox x:Name="TxtBufferDetail" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                 Background="Transparent" TextWrapping="Wrap" BorderThickness="0" Margin="4"
                                 Text="Выберите канал в таблице выше для детального просмотра его элементов." />
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Виртуальная топология -->
            <TabItem Header="Топология (Topology)">
                <Grid Margin="4">
                    <StackPanel Margin="6">
                        <TextBlock Text="Конфигурация параллельной топологии Planning C:" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Border Padding="10" CornerRadius="4"
                                BorderBrush="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}"
                                BorderThickness="1"
                                Background="{DynamicResource {x:Static vsshell:EnvironmentColors.CommandBarGradientBrushKey}}">
                            <StackPanel>
                                <TextBlock x:Name="TxtTopologyInfo" Text="Топология не инициализирована" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <Separator Margin="0,6" />
                                <TextBlock x:Name="TxtProcessorId" Text="Идентификатор процессора (plan_processor_id): -" Margin="0,2" />
                                <TextBlock x:Name="TxtProcessorsCount" Text="Всего процессоров (plan_processors): -" Margin="0,2" />
                                <TextBlock x:Name="TxtLinearNum" Text="Линейный номер узла (plan_linear_num): -" Margin="0,2" />
                                <TextBlock x:Name="TxtTopologyNum" Text="Номер в топологии (plan_topology_num): -" Margin="0,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка 5: Журнал сборки и транслятора -->
            <TabItem Header="Журнал сборки (Log)">
                <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11" Background="Transparent"
                         TextWrapping="Wrap" BorderThickness="0" Margin="4" />
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
